{
  "name": "@flashdata-dev/sdk",
  "version": "1.1.0",
  "description": "Official TypeScript and JavaScript SDK for FlashData Google, YouTube and cloud media APIs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "openapi.json",
    "source-contract.json",
    "!docs/_build/**",
    "!docs/_build"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "FlashData <support@flashdata.dev>",
  "homepage": "https://flashdata.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashdatadev/flashdata-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/flashdatadev/flashdata-typescript/issues"
  },
  "keywords": [
    "flashdata",
    "sdk",
    "google-search",
    "youtube",
    "transcript",
    "bulk",
    "typescript"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/build.mjs && tsc -p tsconfig.examples.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "examples:offline": "node examples/offline.mjs",
    "prepack": "npm run build",
    "docs:build": "typedoc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:live": "npm run build && node --test tests/live.test.mjs",
    "examples:typescript": "node scripts/typed-example.mjs",
    "verify:package": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "prettier": "3.9.10",
    "typedoc": "0.28.20",
    "typescript": "~5.9.3"
  }
}
